generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  TECHNICIAN
}

enum ExecutionSourceType {
  ROUTE
  OLP
}

model AppSettings {
  id Int @id @default(1)

  // =========================
  // Ejecución / Evidencias
  // =========================
  executionEvidenceRequired Boolean @default(false)

  // =========================
  // Inventario
  // =========================
  preventNegativeStock   Boolean @default(true)
  lowStockWarningEnabled Boolean @default(true)

  // =========================
  // Alertas / IA
  // =========================
  technicianOverloadEnabled    Boolean @default(true)
  predictiveAlertsEnabled      Boolean @default(true)
  aiSummaryEnabled             Boolean @default(true)
  criticalActivityEmailEnabled Boolean @default(true)
  conditionReportEmailEnabled  Boolean @default(true)
  overdueSummaryEmailEnabled   Boolean @default(true)
  monthlyReportEmailEnabled    Boolean @default(true)
  monthlyTechSummaryEnabled    Boolean @default(false)

  // =========================
  // Sobrecarga técnicos
  // =========================
  overloadWindowDays          Int   @default(7)
  overloadOverdueLookbackDays Int   @default(30)
  overloadCapacityPerDay      Int   @default(6)
  overloadWarnRatio           Float @default(1.1)
  overloadCriticalRatio       Float @default(1.4)

  // =========================
  // OLP — Órdenes de Lubricación Preventiva
  // =========================
  requiresPhotoOLP Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(TECHNICIAN)
  active       Boolean  @default(true)

  technicianId Int?        @unique
  technician   Technician? @relation("UserTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  notifications             Notification[]
  conditionReports          ConditionReport[]
  dismissedConditionReports ConditionReport[] @relation("ConditionReportDismissedBy")
  requestedPurchaseOrders   PurchaseOrder[]   @relation("PORequester")
  approvedPurchaseOrders    PurchaseOrder[]   @relation("POApprover")
  auditLogs                 AuditLog[]
  createdPreventiveOrders   PreventiveOrder[] @relation("PreventiveOrderCreatedBy")
  stockMovements            MtStockMovement[] @relation("MtStockMovements")

  userPlants UserPlant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Technician {
  id Int @id @default(autoincrement())

  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  name          String
  code          String
  email         String?
  phone         String?
  specialty     String
  certifications String? // JSON array as string
  status        String    @default("Activo")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?

  executions                    Execution[]
  routes                        Route[]
  assignedPreventiveOrders      PreventiveOrder[]
  completedPreventiveOrderItems PreventiveOrderItem[] @relation("PreventiveOrderItemCompletedBy")

  user User? @relation("UserTechnician")

  @@unique([plantId, code]) // recomendado: código único por planta
  @@index([plantId])
}

model EquipmentArea {
  id      Int   @id @default(autoincrement())
  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  createdAt   DateTime @default(now())

  equipments Equipment[]

  @@unique([plantId, name])
  @@index([plantId])
  @@index([name])
}

model Equipment {
  id Int @id @default(autoincrement())

  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  code        String? @unique
  name        String
  location    String
  status      String
  description String?

  areaId Int?
  area   EquipmentArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  criticality String?

  conditionReports ConditionReport[]
  oilSamples       OilSample[]
  assetMappings    AssetMapping[]
  lubricationCard  LubricationCard?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  routes           Route[]
  executions       Execution[]
  preventiveOrders PreventiveOrder[]

  @@index([plantId])
  @@index([areaId])
  @@index([status])
}

model Lubricant {
  id Int @id @default(autoincrement())

  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  name      String
  unit      String  @default("ml")
  stock     Float   @default(0)
  minStock  Float?
  brand     String?
  type      String?
  viscosity String?
  location  String?
  notes     String?

  code     String?
  supplier String?
  unitCost Float?

  // Ficha técnica
  isoVg            String?
  nlgiGrade        String?
  baseType         String? // MINERAL | SINTETICO | SEMISINT
  operatingTempMin Float?
  operatingTempMax Float?
  sdsUrl           String?
  sdsPublicId      String?
  compatibility    String? // texto libre o JSON con IDs compatibles

  routes             Route[]             @relation("LubricantRoutes")
  movements          LubricantMovement[]
  oilSamples         OilSample[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
}

model LubricantMovement {
  id Int @id @default(autoincrement())

  lubricantId Int
  lubricant   Lubricant @relation(fields: [lubricantId], references: [id], onDelete: Cascade)

  executionId Int?
  execution   Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  type     String
  quantity Float
  reason   String?
  note     String?

  // ✅ NUEVO
  inputQuantity     Float?
  inputUnit         String?
  convertedQuantity Float?
  convertedUnit     String?

  stockBefore Float?
  stockAfter  Float?

  createdAt DateTime @default(now())

  @@index([lubricantId, createdAt])
  @@index([executionId])
}

model Route {
  id Int @id @default(autoincrement())

  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  name           String
  normalizedName String
  routeKind      String  @default("LUBRICATION")
  lubricantType  String?
  lubricantName  String?

  quantity Float?
  unit     String? @default("ml")

  pumpStrokeValue Float?
  pumpStrokeUnit  String?

  frequencyDays Int

  frequencyType      String?
  weeklyDays         Int[]   @default([])
  monthlyAnchorDay   Int?
  customIntervalDays Int?

  method       String?
  points       Int?
  instructions String?

  isEmergency Boolean @default(false)

  lastDate DateTime?
  nextDate DateTime?

  imageUrl      String?
  imagePublicId String?

  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  lubricantId Int?
  lubricant   Lubricant? @relation("LubricantRoutes", fields: [lubricantId], references: [id], onDelete: SetNull)

  technicianId Int?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  executions           Execution[]
  preventiveOrderItems PreventiveOrderItem[] @relation("PreventiveOrderItems")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([plantId])
  @@index([equipmentId])
  @@index([lubricantId])
  @@index([technicianId])
  @@index([plantId, equipmentId, normalizedName])
}

model Execution {
  id Int @id @default(autoincrement())

  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  origin ExecutionOrigin @default(ROUTE)

  routeId Int?
  route   Route? @relation(fields: [routeId], references: [id], onDelete: Cascade)

  equipmentId Int?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  manualTitle        String?
  manualInstructions String?

  correctiveReports ConditionReport[] @relation("CorrectiveExecution")

  technicianId Int?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  lubricantMovements LubricantMovement[]

  status      String    @default("PENDING")
  scheduledAt DateTime  @default(now())
  executedAt  DateTime?

  usedQuantity Float?
  condition    String?
  observations String?

  // ✅ NUEVO
  usedInputQuantity     Float?
  usedInputUnit         String?
  usedConvertedQuantity Float?
  usedConvertedUnit     String?

  evidenceImage         String?
  evidenceImagePublicId String?
  evidenceNote          String?

  inventoryDeductedAt DateTime?

  // Clave de idempotencia para operaciones offline. El cliente genera un UUID v4 y lo envía en el body.
  clientId String? @unique

  // Origen de la ejecución: ROUTE | OLP para tracking de órdenes preventivas
  sourceType String? @default("ROUTE")  // Valores: ROUTE | OLP

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([plantId])
  @@index([routeId])
  @@index([equipmentId])
  @@index([technicianId])
  @@index([status, scheduledAt])
  @@index([origin, scheduledAt])
  @@index([sourceType])
}

enum ExecutionOrigin {
  ROUTE
  ONE_OFF
  MANUAL
  // Si quieres separar emergentes:
  // EMERGENCY
}

enum ConditionLevel {
  BUENO
  REGULAR
  MALO
  CRITICO
}

enum ConditionReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ConditionReportCategory {
  FUGA
  RUIDO
  VIBRACION
  TEMPERATURA
  CONTAMINACION
  OTRO
}

enum ScheduledJobType {
  MONTHLY_EXEC_REPORT
  MONTHLY_TECH_SUMMARY
  OVERDUE_SUMMARY
}

enum PurchaseOrderStatus {
  DRAFT
  REQUESTED
  APPROVED
  RECEIVED
  CANCELLED
}

enum OilSampleStatus {
  PENDING
  NORMAL
  CAUTION
  CRITICAL
}

enum WebhookEvent {
  EXECUTION_COMPLETED
  CONDITION_REPORT_CREATED
  LUBRICANT_LOW_STOCK
  OIL_SAMPLE_ALERT
  PURCHASE_ORDER_APPROVED
  PURCHASE_ORDER_RECEIVED
}

model ConditionReport {
  id Int @id @default(autoincrement())

  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  equipmentId  Int
  reportedById Int

  condition             ConditionLevel
  category              ConditionReportCategory?
  description           String
  detectedAt            DateTime                 @db.Date
  evidenceImage         String?
  evidenceImagePublicId String?

  status ConditionReportStatus @default(OPEN)

  correctiveExecutionId Int?
  correctiveExecution   Execution? @relation("CorrectiveExecution", fields: [correctiveExecutionId], references: [id], onDelete: SetNull)
  correctiveNotes       String?
  correctiveScheduledAt DateTime?

  createdAt DateTime @default(now())

  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  reportedBy    User      @relation(fields: [reportedById], references: [id], onDelete: Cascade)
  resolvedAt    DateTime?
  dismissedAt   DateTime?
  dismissedById Int?
  dismissedBy   User?     @relation("ConditionReportDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  @@index([plantId])
  @@index([equipmentId])
  @@index([detectedAt])
  @@index([status])
  @@index([plantId, status])
  @@map("condition_reports")
}

enum NotificationType {
  CONDITION_REPORTED
  CONDITION_RESOLVED
  CONDITION_DISMISSED
  EMERGENCY_CREATED
  EXEC_ASSIGNED
  EXEC_CONDITION_CRITICAL
  EXEC_OVERDUE
  LOW_STOCK
  MONTHLY_TECH_SUMMARY
}

model Notification {
  id Int @id @default(autoincrement())

  plantId Int?
  plant   Plant? @relation(fields: [plantId], references: [id], onDelete: SetNull)

  userId    Int
  type      NotificationType
  title     String
  message   String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plantId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Plant {
  id       Int     @id @default(autoincrement())
  name     String
  timezone String  @default("America/Mexico_City")
  active   Boolean @default(true)

  monthlyReportEnabled         Boolean @default(true)
  monthlyReportDay             Int     @default(1)
  monthlyReportHour            Int     @default(8)
  monthlyReportRecipientsExtra String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relaciones
  userPlants UserPlant[]

  equipmentAreas     EquipmentArea[]
  equipments         Equipment[]
  lubricants         Lubricant[]
  routes             Route[]
  executions         Execution[]
  conditionReports   ConditionReport[]
  notifications      Notification[]
  mtNotifications    MtNotification[]
  mtNotificationPreferences MtNotificationPreference[]
  technicians        Technician[]
  scheduledJobRuns   ScheduledJobRun[]
  purchaseOrders     PurchaseOrder[]
  oilSamples         OilSample[]
  webhookEndpoints   WebhookEndpoint[]
  auditLogs          AuditLog[]
  integrationConfigs IntegrationConfig[]
  preventiveOrders   PreventiveOrder[]
  mtFailureCodes     MtFailureCode[]
  mtSpareParts       MtSparePart[]
  mtWarehouses       MtWarehouse[]
}

model UserPlant {
  id        Int     @id @default(autoincrement())
  userId    Int
  plantId   Int
  isDefault Boolean @default(false)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([userId, plantId])
  @@index([plantId])
}

// =========================
// ÓRDENES DE COMPRA
// =========================
model PurchaseOrder {
  id      Int   @id @default(autoincrement())
  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  status PurchaseOrderStatus @default(DRAFT)
  notes  String?

  requestedById Int
  requestedBy   User  @relation("PORequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedById  Int?
  approvedBy    User? @relation("POApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt   DateTime?
  receivedAt   DateTime?
  expectedDate DateTime?

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([status])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  lubricantId Int
  lubricant   Lubricant @relation(fields: [lubricantId], references: [id], onDelete: Cascade)

  requestedQty Float
  receivedQty  Float?
  unit         String
  unitCost     Float?
  notes        String?

  @@index([purchaseOrderId])
  @@index([lubricantId])
}

// =========================
// ANÁLISIS DE ACEITE
// =========================
model OilSample {
  id      Int   @id @default(autoincrement())
  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  lubricantId Int?
  lubricant   Lubricant? @relation(fields: [lubricantId], references: [id], onDelete: SetNull)

  sampledAt    DateTime
  labReference String?
  labReportUrl String?

  // Propiedades físico-químicas
  viscosity40  Float? // cSt a 40°C
  viscosity100 Float? // cSt a 100°C
  tan          Float? // Total Acid Number mg KOH/g
  tbn          Float? // Total Base Number mg KOH/g
  waterPct     Float? // % agua
  flashPoint   Float? // °C punto de inflamación

  // Metales de desgaste (ppm)
  ironPpm     Float?
  copperPpm   Float?
  aluminumPpm Float?
  leadPpm     Float?
  chromiumPpm Float?
  siliconPpm  Float?

  // Contaminación
  particleCount Int? // ISO 4406
  particleIso   String? // e.g. "18/16/13"

  status OilSampleStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
  @@index([equipmentId])
  @@index([sampledAt])
}

// =========================
// AUDIT LOG
// =========================
model AuditLog {
  id        Int     @id @default(autoincrement())
  plantId   Int?
  userId    Int?
  userEmail String?

  action   String // CREATE | UPDATE | DELETE
  model    String // Route | Equipment | Lubricant | Technician | ...
  recordId String?
  changes  Json? // { before: {}, after: {} }

  ip        String?
  createdAt DateTime @default(now())

  plant Plant? @relation(fields: [plantId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([plantId])
  @@index([model])
  @@index([userId])
  @@index([createdAt])
}

// =========================
// WEBHOOKS
// =========================
model WebhookEndpoint {
  id      Int   @id @default(autoincrement())
  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  url         String
  secret      String
  events      WebhookEvent[]
  active      Boolean        @default(true)
  description String?

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
}

model WebhookDelivery {
  id         Int             @id @default(autoincrement())
  endpointId Int
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  event          String
  payload        Json
  status         String    @default("PENDING") // PENDING | SUCCESS | FAILED
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  responseStatus Int?
  responseBody   String?

  createdAt DateTime @default(now())

  @@index([endpointId, status])
  @@index([status, createdAt])
}

model ScheduledJobRun {
  id      Int              @id @default(autoincrement())
  jobType ScheduledJobType
  plantId Int
  period  String // YYYY-MM
  status  String           @default("PENDING") // PENDING | SENT | FAILED | SKIPPED

  recipientsJson String?
  subject        String?
  errorMessage   String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([jobType, plantId, period])
  @@index([plantId, period])
  @@index([jobType, status])
}

// =========================
// CARTA DE LUBRICACIÓN
// =========================
enum LubricationFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum LubricationMethod {
  MANUAL
  AUTO
  GREASE_GUN
  OIL_CAN
}

enum PreventiveOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PreventiveOrderItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model LubricationCard {
  id          Int       @id @default(autoincrement())
  equipmentId Int       @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  // Imagen principal (backward-compatible)
  imageUrl      String?
  imagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  points LubricationPoint[]
  images LubricationCardImage[]

  @@index([equipmentId])
}

// Imágenes adicionales para equipos grandes con varias secciones
model LubricationCardImage {
  id     Int             @id @default(autoincrement())
  cardId Int
  card   LubricationCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  imageUrl      String
  imagePublicId String?
  label         String  @default("Sección")
  order         Int     @default(0)

  points LubricationPoint[]

  createdAt DateTime @default(now())

  @@index([cardId])
}

model LubricationPoint {
  id     Int             @id @default(autoincrement())
  cardId Int
  card   LubricationCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // null = imagen principal de la carta, non-null = imagen adicional
  imageId Int?
  image   LubricationCardImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  label String
  x     Float
  y     Float

  lubricant String?
  quantity  Float?
  unit      String?              @default("ml")
  frequency LubricationFrequency @default(MONTHLY)
  method    LubricationMethod    @default(MANUAL)
  notes     String?

  // Ruta de origen cuando fue sincronizado automáticamente
  routeId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([imageId])
}

// =========================
// CMMS INTEGRATIONS
// =========================
enum IntegrationType {
  MAXIMO
  SAP_ODATA
  SAP_RFC
  CSV
}

model IntegrationConfig {
  id      Int   @id @default(autoincrement())
  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  type        IntegrationType
  name        String
  baseUrl     String?
  apiKey      String?
  username    String?
  passwordEnc String?
  extra       Json?
  active      Boolean         @default(true)

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assetMappings AssetMapping[]
  syncLogs      IntegrationSyncLog[]

  @@index([plantId])
  @@index([type])
}

model AssetMapping {
  id            Int               @id @default(autoincrement())
  integrationId Int
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  equipmentId Int?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  externalId   String
  externalName String?
  externalData Json?
  confirmed    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([integrationId, externalId])
  @@index([integrationId])
  @@index([equipmentId])
}

model IntegrationSyncLog {
  id            Int               @id @default(autoincrement())
  integrationId Int
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  direction    String // PULL | PUSH
  entity       String // assets | workorders
  status       String // OK | PARTIAL | ERROR
  recordsTotal Int    @default(0)
  recordsOk    Int    @default(0)
  recordsError Int    @default(0)
  errors       Json?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([integrationId])
  @@index([status])
  @@index([startedAt])
}

model LandingChatLog {
  id          Int      @id @default(autoincrement())
  sessionId   String   @unique
  messages    Json
  ip          String?
  source      String   @default("landing")
  isHotLead   Boolean  @default(false)
  hotKeywords String[]
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isHotLead])
  @@index([source])
  @@index([createdAt])
}

model LandingLead {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  telefono  String
  empresa   String?
  source    String   @default("landing")
  sessionId String?
  status    String   @default("NUEVO")
  emailSent Boolean  @default(false)
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([createdAt])
}

// =========================
// ÓRDENES DE LUBRICACIÓN PREVENTIVA (OLP)
// =========================
model PreventiveOrder {
  id Int @id @default(autoincrement())

  plantId Int
  plant   Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  title         String
  scheduledDate DateTime
  status        PreventiveOrderStatus @default(DRAFT)

  createdBy     Int
  createdByUser User @relation("PreventiveOrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  assignedTo     Int?
  assignedToUser Technician? @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  requiresPhoto  Boolean @default(false)
  notes          String?
  signatureImage String?

  items PreventiveOrderItem[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([plantId])
  @@index([equipmentId])
  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
  @@index([plantId, status])
}

model PreventiveOrderItem {
  id Int @id @default(autoincrement())

  preventiveOrderId Int
  preventiveOrder   PreventiveOrder @relation(fields: [preventiveOrderId], references: [id], onDelete: Cascade)

  routeId Int
  route   Route @relation("PreventiveOrderItems", fields: [routeId], references: [id], onDelete: Cascade)

  status PreventiveOrderItemStatus @default(PENDING)

  observations String?
  photoUrl     String?

  completedAt     DateTime?
  completedBy     Int?
  completedByUser Technician? @relation("PreventiveOrderItemCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([preventiveOrderId, routeId])
  @@index([preventiveOrderId])
  @@index([routeId])
  @@index([status])
}

// =========================
// MAINTENANCE MODULE (Mt*)
// =========================
enum MtWorkOrderType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
}

enum MtWorkOrderStatus {
  REQUESTED
  REJECTED
  APPROVED
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  WAITING_PRODUCTION
  FINISHED
  VALIDATED
  CANCELLED
}

enum MtWorkOrderPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MtAssetLevel {
  AREA
  LINE
  EQUIPMENT
  SUBASSEMBLY
  COMPONENT
}

enum MtAssetCriticality {
  A
  B
  C
}

enum MtAssetStatus {
  OPERATING
  STOPPED
  OUT_OF_SERVICE
}

model MtPlantAccess {
  id        Int     @id @default(autoincrement())
  plantId   Int     @unique
  enabled   Boolean @default(false)
  plan      String?
  enabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
}

model MtCounter {
  id    Int    @id @default(autoincrement())
  plantId Int
  key   String
  value Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, key])
  @@index([plantId])
}

model MtAsset {
  id           Int            @id @default(autoincrement())
  plantId      Int
  parentId     Int?
  parent       MtAsset?       @relation("AssetHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     MtAsset[]      @relation("AssetHierarchy")

  level        MtAssetLevel
  code         String
  name         String
  location     String?
  manufacturer String?
  model        String?
  serialNumber String?
  installedAt  DateTime?
  criticality  MtAssetCriticality?
  status       MtAssetStatus      @default(OPERATING)
  notes        String?
  deletedAt    DateTime?

  workOrders MtWorkOrder[]
  plans      MtPlan[]
  meterReadings MtMeterReading[]
  spareParts MtSparePartAsset[] @relation("AssetSpareParts")
  failures   MtWorkOrderFailure[] @relation("AssetFailures")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, code])
  @@index([plantId])
  @@index([parentId])
  @@index([level])
  @@index([deletedAt])
}

model MtWorkOrder {
  id           Int                    @id @default(autoincrement())
  plantId      Int
  number       Int
  type         MtWorkOrderType
  status       MtWorkOrderStatus      @default(REQUESTED)
  priority     MtWorkOrderPriority    @default(MEDIUM)

  assetId      Int?
  asset        MtAsset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)

  title        String
  description  String?
  requestedBy  Int
  assignedTo   Int?
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  validatedAt  DateTime?
  validatedBy  Int?

  diagnosis    String?
  failureCause String?
  workDone     String?
  downtimeMinutes Int?

  version      Int    @default(0)
  planId       Int?
  cycleKey     String?

  dueAt        DateTime?
  sourceWorkOrderId Int?
  rescheduleCount Int @default(0)

  events       MtWorkOrderEvent[]
  photos       MtWorkOrderPhoto[]
  tasks        MtWorkOrderTask[]
  parts        MtWorkOrderPart[] @relation("WorkOrderParts")
  failure      MtWorkOrderFailure? @relation("WorkOrderFailure")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, number])
  @@index([plantId])
  @@index([status])
  @@index([assetId])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([plantId, status])
  @@index([plantId, assetId])
  @@index([plantId, assignedTo])
  @@index([plantId, createdAt])
}

model MtWorkOrderEvent {
  id        Int     @id @default(autoincrement())
  workOrderId Int
  workOrder MtWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  plantId   Int

  fromStatus  MtWorkOrderStatus?
  toStatus    MtWorkOrderStatus
  userId      Int
  comment     String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([workOrderId])
  @@index([plantId])
  @@index([createdAt])
}

model MtWorkOrderPhoto {
  id        Int     @id @default(autoincrement())
  workOrderId Int
  workOrder MtWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  plantId   Int

  kind       String // BEFORE | AFTER | OTHER
  url        String
  publicId   String
  uploadedBy Int
  createdAt  DateTime @default(now())

  @@index([workOrderId])
  @@index([plantId])
}

// =========================
// MAINTENANCE PHASE 2 (Mt*)
// =========================
enum MtTriggerType {
  TIME
  METER
}

enum MtScheduleMode {
  FIXED
  FLOATING
}

enum MtTaskKind {
  CHECK
  MEASURE
  TEXT
}

enum MtTaskResult {
  OK
  NOT_OK
  NA
}

model MtPlan {
  id            Int             @id @default(autoincrement())
  plantId       Int
  code          String
  assetId       Int
  asset         MtAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  type          MtWorkOrderType @default(PREVENTIVE)
  triggerType   MtTriggerType   @default(TIME)

  frequencyUnit String?
  frequencyEvery Int?
  meterIntervalHours Float?
  meterBaseline Float?
  lastMeterTrigger Float?

  scheduleMode  MtScheduleMode @default(FIXED)
  anchorDate    DateTime
  leadDays      Int @default(0)
  graceDays     Int @default(0)

  priority      MtWorkOrderPriority @default(MEDIUM)
  defaultAssigneeId Int?
  estimatedMinutes Int?
  skipIfOpen    Boolean @default(true)

  active        Boolean @default(true)
  nextDueAt     DateTime?
  lastGeneratedAt DateTime?
  lastCompletedAt DateTime?

  createdBy     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tasks         MtPlanTask[]
  runs          MtPlanRun[]

  @@unique([plantId, code])
  @@index([plantId])
  @@index([assetId])
  @@index([active])
  @@index([nextDueAt])
}

model MtPlanTask {
  id              Int        @id @default(autoincrement())
  planId          Int
  plan            MtPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  position        Int
  description     String
  kind            MtTaskKind
  unit            String?
  minValue        Float?
  maxValue        Float?
  required        Boolean @default(true)
  createsCorrectiveOnFail Boolean @default(false)

  createdAt       DateTime @default(now())

  @@index([planId])
}

model MtWorkOrderTask {
  id              Int        @id @default(autoincrement())
  workOrderId     Int
  workOrder       MtWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  plantId         Int

  position        Int
  description     String
  kind            MtTaskKind
  unit            String?
  minValue        Float?
  maxValue        Float?
  required        Boolean @default(true)
  createsCorrectiveOnFail Boolean @default(false)

  result          MtTaskResult?
  valueNumber     Float?
  valueText       String?
  note            String?
  doneBy          Int?
  doneAt          DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workOrderId])
  @@index([plantId])
}

model MtMeterReading {
  id        Int     @id @default(autoincrement())
  plantId   Int
  assetId   Int
  asset     MtAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  value     Float
  readAt    DateTime
  source    String @default("MANUAL")
  isReset   Boolean @default(false)
  userId    Int
  note      String?

  createdAt DateTime @default(now())

  @@index([assetId, readAt])
  @@index([plantId])
}

model MtPlanRun {
  id          Int     @id @default(autoincrement())
  plantId     Int
  planId      Int
  plan        MtPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  runAt       DateTime @default(now())
  trigger     String
  dryRun      Boolean @default(false)
  decision    String
  cycleKey    String?
  dueAt       DateTime?
  workOrderId Int?

  missedCycles Int @default(0)
  detail      Json?

  createdAt   DateTime @default(now())

  @@index([planId, runAt])
  @@index([plantId])
}

// =========================
// MAINTENANCE PHASE 3A
// Spare Parts & Inventory
// =========================

enum MtStockMovementType {
  IN
  OUT
  ADJUST
  TRANSFER
}

model MtSparePart {
  id              Int     @id @default(autoincrement())
  plantId         Int
  code            String
  name            String
  description     String?
  category        String?
  brand           String?
  partNumber      String?
  unit            String  @default("piece")
  minStock        Decimal @default(0)
  maxStock        Decimal @default(0)
  location        String?
  costPerUnit     Decimal @default(0)
  status          String  @default("ACTIVE") // ACTIVE, INACTIVE
  version         Int     @default(0)

  plant           Plant                   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  assets          MtSparePartAsset[]
  stocks          MtStock[]
  workOrderParts  MtWorkOrderPart[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([plantId, code])
  @@index([plantId])
  @@index([status])
}

model MtWarehouse {
  id              Int     @id @default(autoincrement())
  plantId         Int
  name            String
  location        String?

  plant           Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  stocks          MtStock[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([plantId, name])
  @@index([plantId])
}

model MtStock {
  id              Int     @id @default(autoincrement())
  warehouseId     Int
  sparePartId     Int
  quantity        Decimal @default(0)
  lastCost        Decimal @default(0)
  version         Int     @default(0)

  warehouse       MtWarehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sparePart       MtSparePart      @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  movements       MtStockMovement[]

  updatedAt       DateTime @updatedAt

  @@unique([warehouseId, sparePartId])
  @@index([warehouseId])
  @@index([sparePartId])
}

model MtStockMovement {
  id              Int     @id @default(autoincrement())
  stockId         Int
  type            MtStockMovementType
  quantity        Decimal
  reason          String?
  costPerUnit     Decimal @default(0)
  referenceId     Int?    // workOrderId or transferId
  referenceType   String? // WORK_ORDER, TRANSFER
  createdById     Int

  stock           MtStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  createdBy       User    @relation("MtStockMovements", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now())

  @@index([stockId])
  @@index([createdAt])
  @@index([referenceId])
}

model MtWorkOrderPart {
  id              Int     @id @default(autoincrement())
  workOrderId     Int
  sparePartId     Int
  quantity        Decimal
  costPerUnitAtTime Decimal

  workOrder       MtWorkOrder @relation("WorkOrderParts", fields: [workOrderId], references: [id], onDelete: Cascade)
  sparePart       MtSparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now())

  @@index([workOrderId])
  @@index([sparePartId])
}

model MtSparePartAsset {
  id              Int     @id @default(autoincrement())
  sparePartId     Int
  assetId         Int

  sparePart       MtSparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  asset           MtAsset     @relation("AssetSpareParts", fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([sparePartId, assetId])
  @@index([assetId])
}

model MtFailureCode {
  id              Int     @id @default(autoincrement())
  plantId         Int
  code            String
  name            String
  category        String  // FAILURE_MODE, MECHANISM, ROOT_CAUSE (ISO 14224)
  parentId        Int?
  assetClass      String? // rotating, electrical, pneumatic, structural, instrumentation
  status          String  @default("ACTIVE") // ACTIVE, INACTIVE
  isBaseCode      Boolean @default(false)

  plant           Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  parent          MtFailureCode? @relation("hierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        MtFailureCode[] @relation("hierarchy")
  // workOrderFailures MtWorkOrderFailure[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([plantId, code])
  @@index([plantId])
  @@index([category])
}

model MtWorkOrderFailure {
  id              Int     @id @default(autoincrement())
  workOrderId     Int     @unique
  assetId         Int
  failureModeId   Int?
  mechanismId     Int?
  rootCauseId     Int?
  productionEffect String? // TOTAL_STOP, PARTIAL_STOP, NO_EFFECT

  workOrder       MtWorkOrder     @relation("WorkOrderFailure", fields: [workOrderId], references: [id], onDelete: Cascade)
  asset           MtAsset         @relation("AssetFailures", fields: [assetId], references: [id], onDelete: Restrict)
  // failureMode     MtFailureCode?  @relation("failureMode", fields: [failureModeId], references: [id], onDelete: SetNull)
  // mechanism       MtFailureCode?  @relation("mechanism", fields: [mechanismId], references: [id], onDelete: SetNull)
  // rootCause       MtFailureCode?  @relation("rootCause", fields: [rootCauseId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =========================
// MAINTENANCE NOTIFICATIONS (Phase 4)
// =========================

model MtNotification {
  id              Int     @id @default(autoincrement())
  plantId         Int
  userId          Int?    // null = para todos los supervisores
  type            String  // LOW_STOCK, OVERDUE_WO, TECHNICIAN_OVERLOAD, PREVENTIVE_SOON, CRITICAL_FAILURE
  title           String
  message         String
  severity        String  @default("INFO") // INFO, WARNING, CRITICAL

  referenceId     Int?    // OT ID, Asset ID, SparePart ID, etc.
  referenceType   String? // WORK_ORDER, ASSET, SPARE_PART, PLAN

  isRead          Boolean @default(false)
  readAt          DateTime?

  actionUrl       String? // Link para ir al recurso
  actionLabel     String? // "Ver orden", "Ir a inventario"

  plant           Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  expiresAt       DateTime? // Se auto-borra después de N días

  @@index([plantId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model MtNotificationPreference {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  plantId         Int

  // Alert types
  lowStockEnabled         Boolean @default(true)
  overdueWoEnabled        Boolean @default(true)
  technicianOverloadEnabled Boolean @default(true)
  preventiveSoonEnabled   Boolean @default(true)
  criticalFailureEnabled  Boolean @default(true)

  // Channels
  inAppEnabled    Boolean @default(true)
  emailEnabled    Boolean @default(false)

  plant           Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([plantId])
}
